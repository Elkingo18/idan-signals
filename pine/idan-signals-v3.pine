// Idan Signals v3.5 — 2026-07-30
// v3.5: explicit BUY/SELL text on every signal shape + live status table (top-right corner).
// ALL-ENGLISH, no format.* namespace (compat with every Pine build). Hebrew inside Pine code breaks on paste (RTL reordering) — v3.2 lesson.
// Logic identical to the engine: swing breakout (ATR-tight stop, R-multiple targets),
// day ORB (paper only), gold 4 patterns BOTH directions. No line wraps anywhere.
//@version=5
indicator("Idan Signals v3", overlay=true, max_labels_count=300)

// ---------------------------------------------------------------- inputs
grpS = "SWING (Daily)"
useSwing  = input.bool(true,  "Enable swing", group=grpS)
pivLen    = input.int(3,      "Pivot length", minval=1, group=grpS)
maLen     = input.int(50,     "Trend MA", minval=5, group=grpS)
rsiLen    = input.int(14,     "RSI", minval=2, group=grpS)
volLen    = input.int(20,     "Volume MA", minval=2, group=grpS)
volMult   = input.float(1.3,  "Volume mult", step=0.1, group=grpS)
atrLen    = input.int(14,     "ATR", minval=2, group=grpS)
atrMult   = input.float(1.6,  "ATR stop mult", step=0.1, group=grpS)
rrT1      = input.float(2.0,  "Target 1 (R)", step=0.5, group=grpS)
rrT2      = input.float(3.5,  "Target 2 (R)", step=0.5, group=grpS)
minRR     = input.float(1.5,  "Min R:R", step=0.1, group=grpS)
maxStopP  = input.float(12.0, "Max stop %", step=0.5, group=grpS)

grpD = "DAY ORB (experimental - PAPER ONLY)"
useDay    = input.bool(false, "Enable day-trade", group=grpD)
orbMin    = input.int(15,     "Opening range minutes", group=grpD)
minBarsOR = input.int(6,      "Min bars after open", group=grpD)
maxExtVW  = input.float(1.5,  "Max distance from VWAP %", step=0.1, group=grpD)
entryFrom = input.session("1005-1100", "Entry window (NY time)", group=grpD)
dayRR1    = input.float(2.0,  "Day target 1 (R)", step=0.5, group=grpD)

grpG = "GOLD (5m chart only)"
useGold   = input.bool(false, "Enable gold (turn on ONLY on XAUUSD 5m)", group=grpG)
eFast     = input.int(9,  "EMA fast", group=grpG)
eMid      = input.int(21, "EMA mid", group=grpG)
eSlow     = input.int(50, "EMA slow", group=grpG)
gAtrMult  = input.float(1.5, "Gold ATR stop mult", step=0.1, group=grpG)

grpA = "Alerts"
sendAlerts = input.bool(true,  "Send alerts (push/email)", group=grpA)
autoAlerts = input.bool(false, "!! JSON webhook for auto-execution - OFF on purpose", group=grpA)
wallet     = input.float(1000, "Wallet ($) - UHTA", group=grpA)
riskPct    = input.float(4.0,  "Risk per trade %", step=0.5, group=grpA)
maxNotP    = input.float(35.0, "Max % of wallet per position", step=5, group=grpA)

// ---------------------------------------------------------------- shared
rsi  = ta.rsi(close, rsiLen)
atrV = ta.atr(atrLen)
ma   = ta.sma(close, maLen)
volOk  = volume > ta.sma(volume, volLen) * volMult
volOkG = volume > ta.sma(volume, 20) * 1.3
newSession = ta.change(time("D")) != 0
var float cumPV = 0.0
var float cumV  = 0.0
if newSession
    cumPV := 0.0
    cumV  := 0.0
cumPV += hlc3 * volume
cumV  += volume
vwapS = cumV > 0 ? cumPV / cumV : close

f_size(entry, stop) =>
    r = math.abs(entry - stop)
    byRisk = r > 0 ? (wallet * riskPct / 100.0) / r : 0.0
    byNot  = (wallet * maxNotP / 100.0) / entry
    math.floor(math.min(byRisk, byNot))

// ---------------------------------------------------------------- SWING
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
var float res = na
var float sup = na
if not na(ph)
    res := ph
if not na(pl)
    sup := pl

trendUp   = close > ma
brokeUp   = not na(res) and close > res and close[1] <= res
swingRaw  = useSwing and brokeUp and volOk and rsi > 50 and trendUp
sStopRaw  = not na(sup) ? math.max(sup, close - atrMult * atrV) : close - atrMult * atrV
sStop     = sStopRaw >= close * 0.995 ? close - math.max(atrV, close * 0.015) : sStopRaw
sRisk     = close - sStop
sStopPct  = sRisk / close * 100
sT1       = close + rrT1 * sRisk
sT2       = close + rrT2 * sRisk
sRoom     = (not na(res) and not na(sup)) ? res + (res - sup) : na
roomOk    = na(sRoom) or sRoom >= close + minRR * sRisk
swingOk   = swingRaw and sStopPct <= maxStopP and sStopPct >= 1.2 and roomOk and rrT1 >= minRR
sQty      = f_size(close, sStop)

// ---------------------------------------------------------------- DAY (ORB)
isIntra   = timeframe.isintraday
barsIn    = ta.barssince(newSession)
inORB     = isIntra and barsIn * timeframe.multiplier < orbMin
var float orH = na
var float orL = na
if newSession
    orH := high
    orL := low
else if inORB
    orH := math.max(nz(orH, high), high)
    orL := math.min(nz(orL, low), low)

inWindow  = not na(time(timeframe.period, entryFrom, "America/New_York"))
extVWpct  = math.abs(close - vwapS) / vwapS * 100
dayRaw    = useDay and isIntra and not inORB and not na(orH) and close > orH and close[1] <= orH and close > vwapS and volOk and rsi > 50
dayOk     = dayRaw and barsIn >= minBarsOR and extVWpct <= maxExtVW and inWindow
dStop     = orL
dRisk     = close - nz(dStop, close)
dT1       = close + dayRR1 * dRisk
dT2       = close + 3.0 * dRisk
dQty      = dRisk > 0 ? f_size(close, dStop) : 0

// ---------------------------------------------------------------- GOLD (both directions)
e9  = ta.ema(close, eFast)
e21 = ta.ema(close, eMid)
e50 = ta.ema(close, eSlow)
crossUp  = ta.crossover(e9, e21)
crossDn  = ta.crossunder(e9, e21)
recentUp = crossUp or crossUp[1] or crossUp[2]
recentDn = crossDn or crossDn[1] or crossDn[2]
gBull    = e9 > e21 and close > e50
gBear    = e9 < e21 and close < e50
gPullL   = gBull and ta.lowest(low, 3) <= e21 and close > e9 and rsi >= 45 and rsi <= 70
gVwapL   = gBull and close > vwapS and close[1] <= vwapS[1]
gBreakL  = gBull and close > ta.highest(high[1], 12) and volOkG and rsi > 52
goldBuy  = useGold and close > vwapS and rsi > 50 and (recentUp or gPullL or gVwapL or gBreakL)
gPullS   = gBear and ta.highest(high, 3) >= e21 and close < e9 and rsi >= 30 and rsi <= 55
gVwapS_  = gBear and close < vwapS and close[1] >= vwapS[1]
gBreakS  = gBear and close < ta.lowest(low[1], 12) and volOkG and rsi < 48
goldSell = useGold and close < vwapS and rsi < 50 and (recentDn or gPullS or gVwapS_ or gBreakS)
gRisk    = gAtrMult * atrV
gStop    = close - gRisk
gT1      = close + 1.5 * gRisk
gT2      = close + 3.0 * gRisk
gStopS   = close + gRisk
gT1S     = close - 1.5 * gRisk
gT2S     = close - 3.0 * gRisk

// ---------------------------------------------------------------- plots
plot(useSwing ? ma : na, "Trend MA", color=color.new(color.orange, 40), linewidth=1)
plot(isIntra ? vwapS : na, "Session VWAP", color=color.new(color.aqua, 30), linewidth=1)
plot(useGold ? e9 : na, "EMA9", color=color.new(color.lime, 40))
plot(useGold ? e21 : na, "EMA21", color=color.new(color.yellow, 40))
plot(useGold ? e50 : na, "EMA50", color=color.new(color.red, 55))
plot(useSwing and not na(res) ? res : na, "Resistance", style=plot.style_stepline, color=color.new(color.red, 55))
plot(useSwing and not na(sup) ? sup : na, "Support", style=plot.style_stepline, color=color.new(color.green, 55))

anySig = swingOk or dayOk or goldBuy or goldSell
plotshape(swingOk, "Swing BUY", shape.labelup, location.belowbar, color.new(color.teal, 0), text="BUY", textcolor=color.white, size=size.small)
plotshape(dayOk, "Day BUY", shape.triangleup, location.belowbar, color.new(color.blue, 0), text="BUY", textcolor=color.new(color.aqua, 0), size=size.small)
plotshape(goldBuy, "Gold BUY", shape.diamond, location.belowbar, color.new(color.yellow, 0), text="BUY", textcolor=color.new(color.yellow, 0), size=size.small)
plotshape(goldSell, "Gold SELL", shape.diamond, location.abovebar, color.new(color.orange, 0), text="SELL", textcolor=color.new(color.orange, 0), size=size.small)

// ---------------------------------------------------------------- live status table (top-right)
var table panel = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 25), frame_color=color.new(color.gray, 55), frame_width=1, border_color=color.new(color.gray, 80), border_width=1)
if barstate.islast
    swTxt = not useSwing ? "OFF" : swingOk ? "BUY" : "WAIT"
    dyTxt = not useDay ? "OFF" : dayOk ? "BUY" : "WAIT"
    gdTxt = not useGold ? "OFF" : goldBuy ? "BUY" : goldSell ? "SELL" : "WAIT"
    swCol = swingOk ? color.lime : color.silver
    dyCol = dayOk ? color.lime : color.silver
    gdCol = goldBuy ? color.lime : goldSell ? color.orange : color.silver
    table.cell(panel, 0, 0, "IDAN v3.5", text_color=color.aqua, text_size=size.small)
    table.cell(panel, 1, 0, syminfo.ticker, text_color=color.silver, text_size=size.small)
    table.cell(panel, 0, 1, "SWING", text_color=color.silver, text_size=size.small)
    table.cell(panel, 1, 1, swTxt, text_color=swCol, text_size=size.small)
    table.cell(panel, 0, 2, "DAY", text_color=color.silver, text_size=size.small)
    table.cell(panel, 1, 2, dyTxt, text_color=dyCol, text_size=size.small)
    table.cell(panel, 0, 3, "GOLD", text_color=color.silver, text_size=size.small)
    table.cell(panel, 1, 3, gdTxt, text_color=gdCol, text_size=size.small)

if swingOk
    label.new(bar_index, low, "BUY " + str.tostring(close, "#.##") + "\nSL " + str.tostring(sStop, "#.##") + " (" + str.tostring(sStopPct, "#.#") + "%)" + "\nT1 " + str.tostring(sT1, "#.##") + "  T2 " + str.tostring(sT2, "#.##") + "\nQty " + str.tostring(sQty), style=label.style_label_up, color=color.new(color.teal, 20), textcolor=color.white, size=size.small)

// ---------------------------------------------------------------- alerts
f_msg(act, entry, stop, t1, t2, qty) =>
    act + " " + syminfo.ticker + " @ " + str.tostring(entry, "#.##") + " | SL " + str.tostring(stop, "#.##") + " | T1 " + str.tostring(t1, "#.##") + " | T2 " + str.tostring(t2, "#.##") + " | Qty " + str.tostring(qty)

f_json(kind, entry, stop, t1, t2, qty) =>
    '{"strategy":"idan_v3","kind":"' + kind + '","action":"buy","symbol":"' + syminfo.ticker + '","entry":' + str.tostring(entry) + ',"stop":' + str.tostring(stop) + ',"t1":' + str.tostring(t1) + ',"t2":' + str.tostring(t2) + ',"qty":' + str.tostring(qty) + ',"tf":"' + timeframe.period + '"}'

if sendAlerts and swingOk
    alert(autoAlerts ? f_json("swing", close, sStop, sT1, sT2, sQty) : "📈 SWING " + f_msg("BUY", close, sStop, sT1, sT2, sQty), alert.freq_once_per_bar_close)
if sendAlerts and dayOk
    alert(autoAlerts ? f_json("day", close, dStop, dT1, dT2, dQty) : "⚡ DAY (paper) " + f_msg("BUY", close, dStop, dT1, dT2, dQty), alert.freq_once_per_bar_close)
if sendAlerts and goldBuy
    alert(autoAlerts ? f_json("gold", close, gStop, gT1, gT2, 0) : "🪙 GOLD " + f_msg("BUY", close, gStop, gT1, gT2, 0), alert.freq_once_per_bar_close)
if sendAlerts and goldSell
    alert("🪙 GOLD " + f_msg("SELL", close, gStopS, gT1S, gT2S, 0), alert.freq_once_per_bar_close)

alertcondition(swingOk, "Idan - Swing BUY", "📈 Swing BUY {{ticker}} @ {{close}}")
alertcondition(dayOk, "Idan - Day BUY (paper)", "⚡ Day BUY {{ticker}} @ {{close}}")
alertcondition(goldBuy, "Idan - Gold BUY", "🪙 Gold BUY {{ticker}} @ {{close}}")
alertcondition(goldSell, "Idan - Gold SELL", "🪙 Gold SELL {{ticker}} @ {{close}}")
alertcondition(anySig, "Idan - ANY signal", "⚡ Idan Signals: {{ticker}} @ {{close}}")
